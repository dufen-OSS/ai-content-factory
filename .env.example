# ===== LLM 供应商切换 =====
# 可选值: deepseek / openai / ollama / mock
#   deepseek: 调 DeepSeek 官方 OpenAI 兼容接口
#   openai:   调任意 OpenAI 兼容接口（智谱/通义/硅基流动等，改 base_url 即可）
#   ollama:   本地 Ollama（OpenAI 兼容端点 /v1，无需 Key）
#   mock:     离线规则引擎，无 Key 也能演示完整链路
LLM_PROVIDER=deepseek

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== OpenAI 兼容（LLM_PROVIDER=openai 时使用）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 本地 Ollama（LLM_PROVIDER=ollama 时使用）=====
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ===== 服务 =====
# FastAPI 监听端口
APP_PORT=8000
# 单次 LLM 调用超时（秒）
LLM_TIMEOUT=120
# 审核不通过自动返修的最大次数
MAX_REVIEW_RETRIES=2
