# AI 电商内容工厂 - Streamlit Secrets 模板
# 部署到 Streamlit Cloud：Settings -> Secrets，把下面内容粘进去（不含注释说明）。
# 本地测试：复制本文件为 .streamlit/secrets.toml（已被 .gitignore 忽略，不会上传 GitHub）。

# ---- LLM 供应商：openai / deepseek / ollama / mock ----
LLM_PROVIDER = "openai"

# ---- 百炼（DashScope）OpenAI 兼容端点 ----
OPENAI_API_KEY = "sk-你的百炼Key"
OPENAI_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
OPENAI_MODEL = "qwen3.7-max-2026-05-20"

# ---- 或者用 DeepSeek（注释掉上面，启用下面）----
# DEEPSEEK_API_KEY = "sk-你的DeepSeekKey"
# DEEPSEEK_BASE_URL = "https://api.deepseek.com"
# DEEPSEEK_MODEL = "deepseek-chat"

# ---- 或者本地 Ollama（仅本地测试，云端不可用）----
# OLLAMA_BASE_URL = "http://localhost:11434/v1"
# OLLAMA_MODEL = "qwen2.5:7b"
